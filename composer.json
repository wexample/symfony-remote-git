{
  "name": "wexample/symfony-remote-git",
  "description": "The repositories of GitHub and GitLab accounts and the commits of each day, kept up to date and summed up for symfony-git",
  "version": "2.0.3",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "symfony/console": "^7.4 || ^8.0",
    "wexample/php-remote-git": ">=1.0.0",
    "wexample/symfony-git": ">=5.0.0",
    "wexample/symfony-helpers": ">=19.1.0",
    "wexample/symfony-remote": ">=2.1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyRemoteGit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyRemoteGit\\Tests\\": "tests/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}